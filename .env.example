# ============================================
# Almeida Inteligência — Variáveis de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com valores reais.
# NUNCA commite o .env no repositório!
#
# Para gerar chaves seguras, use:
#   python -c "import secrets; print(secrets.token_hex(32))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ── Banco de Dados ──
DB_NAME=almeida
DB_USER=almeida
DB_PASSWORD=TROCAR_SENHA_FORTE_AQUI

# ── Portal (backend de autenticação) ──
PORTAL_SECRET_KEY=TROCAR_GERAR_COM_secrets.token_hex(32)

# ── Email Classifier ──
EMAIL_FERNET_SECRET_KEY=TROCAR_GERAR_COM_Fernet.generate_key()
EMAIL_JWT_SECRET_KEY=TROCAR_GERAR_COM_secrets.token_hex(32)

# ── Central Backend ──
CENTRAL_FERNET_SECRET_KEY=TROCAR_GERAR_COM_Fernet.generate_key()
CENTRAL_JWT_SECRET_KEY=TROCAR_GERAR_COM_secrets.token_hex(32)

# ── Meta WhatsApp Cloud API ──
# App Secret do app no Meta for Developers — usado pra validar a assinatura
# HMAC (X-Hub-Signature-256) dos webhooks. Token de acesso e Phone Number ID
# são configurados por usuário no painel /assistente-painel/.
WHATSAPP_APP_SECRET=TROCAR_PELO_APP_SECRET_DO_META

# ── Google OAuth (Agendamento) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_BASE_URL=http://localhost:8080

# ── Deploy ──
DEPLOY_TOKEN=TROCAR_GERAR_COM_secrets.token_hex(32)
