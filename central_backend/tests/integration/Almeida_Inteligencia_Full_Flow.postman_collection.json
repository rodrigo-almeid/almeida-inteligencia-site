				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/abastecimentos/", "host": ["{{central_api}}"], "path": ["abastecimentos", ""] } } }
			]
		},
		{
			"name": "03 — RBAC: Perfil Parcial (só automacao_financeira)",
			"item": [
				{ "name": "03.1 Atribuir automacao_financeira", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
					"pm.test('Perfil atribuído', function () { pm.expect(pm.response.json().perfis).to.eql(['automacao_financeira']); });"
