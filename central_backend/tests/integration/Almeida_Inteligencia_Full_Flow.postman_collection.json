{
	"info": {
		"_postman_id": "almeida-inteligencia-full-flow",
		"name": "Almeida Inteligência — Fluxo Completo (RBAC + CRUD + Cleanup)",
		"description": "Fluxo E2E: registra usuario e valida login/perfis vazios (pasta 01). As pastas 02-05 (RBAC com atribuicao de perfil via /auth/perfis/atribuir, CRUD completo e cleanup) foram REMOVIDAS temporariamente em 2026-07-09 porque o sistema de perfis (Portal <-> central_backend) esta sendo revisado e os estados de perfil em producao nao sao confiaveis no momento. O conteudo original esta no historico do git (commit anterior a esta mudanca) — restaurar as pastas quando o /auth/perfis/atribuir e o fluxo de perfis do Portal estiverem corrigidos e estaveis.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "https://almeidainteligencia.com.br"
		},
		{
			"key": "central_api",
			"value": "{{base_url}}/central"
		},
		{
			"key": "token",
			"value": ""
		},
		{
			"key": "admin_token",
			"value": ""
		},
		{
			"key": "test_email",
			"value": ""
		},
		{
			"key": "test_password",
			"value": "Test@12345"
		},
		{
			"key": "admin_email",
			"value": "almeidainteligencia@gmail.com"
		},
		{
			"key": "admin_password",
			"value": "REDACTED"
		},
		{
			"key": "categoria_id",
			"value": ""
		},
		{
			"key": "conta_id",
			"value": ""
		},
		{
			"key": "divida_id",
			"value": ""
		},
		{
			"key": "pessoa_id",
			"value": ""
		},
		{
			"key": "senha_id",
			"value": ""
		},
		{
			"key": "dado_pessoal_id",
			"value": ""
		},
		{
			"key": "abastecimento_id",
			"value": ""
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"if (!pm.collectionVariables.get('test_email') || pm.collectionVariables.get('test_email') === '') {",
					"    pm.collectionVariables.set('test_email', 'postman_rbac_' + Date.now() + '@teste.com');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "01 — Auth + Setup",
			"item": [
				{
					"name": "01.1 Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
									"pm.test('Token salvo', function () { pm.collectionVariables.set('admin_token', pm.response.json().access_token); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "{{admin_email}}"
								},
								{
									"key": "password",
									"value": "{{admin_password}}"
								}
							]
						},
						"url": {
							"raw": "{{central_api}}/auth/login",
							"host": [
								"{{central_api}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "01.2 Registrar Usuário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 201', function () { pm.expect(pm.response.code).to.equal(201); });",
									"pm.test('Sucesso', function () { pm.expect(pm.response.json().message).to.include('sucesso'); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"email\": \"{{test_email}}\", \"password\": \"{{test_password}}\"}"
						},
						"url": {
							"raw": "{{central_api}}/auth/register",
							"host": [
								"{{central_api}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					}
				},
				{
					"name": "01.3 Login Usuário",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
									"pm.test('JWT válido', function () { var j = pm.response.json(); pm.expect(j.access_token.split('.').length).to.equal(3); pm.collectionVariables.set('token', j.access_token); });",
									"pm.test('Bearer', function () { pm.expect(pm.response.json().token_type.toLowerCase()).to.equal('bearer'); });"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "username",
									"value": "{{test_email}}"
								},
								{
									"key": "password",
									"value": "{{test_password}}"
								}
							]
						},
						"url": {
							"raw": "{{central_api}}/auth/login",
							"host": [
								"{{central_api}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					}
				},
				{
					"name": "01.4 Perfis = vazio",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
									"pm.test('Sem perfis', function () { pm.expect(pm.response.json()).to.be.an('array').with.length(0); });"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{central_api}}/me/perfis",
							"host": [
								"{{central_api}}"
							],
							"path": [
								"me",
								"perfis"
							]
						}
					}
				}
			]
		}
	]
}
