				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/pessoas/", "host": ["{{central_api}}"], "path": ["pessoas", ""] } } },
				{ "name": "03.6 /abastecimentos/ → 403", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('403 — sem perfil combustivel', function () { pm.expect(pm.response.code).to.equal(403); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/abastecimentos/", "host": ["{{central_api}}"], "path": ["abastecimentos", ""] } } }
			]
		},
		{
			"name": "04 — Atribuir Todos os Perfis + CRUD",
			"item": [
