				{ "name": "02.4 /pessoas/ → 403", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('403', function () { pm.expect(pm.response.code).to.equal(403); });",
					"pm.test('Indica perfil gerenciador_credenciais', function () { pm.expect(pm.response.json().detail).to.include('gerenciador_credenciais'); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/pessoas/", "host": ["{{central_api}}"], "path": ["pessoas", ""] } } },
				{ "name": "02.5 /abastecimentos/ → 403", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('403', function () { pm.expect(pm.response.code).to.equal(403); });",
