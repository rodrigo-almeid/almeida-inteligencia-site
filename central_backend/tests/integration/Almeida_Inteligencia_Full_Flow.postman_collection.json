			"item": [
				{ "name": "05.01 DEL Abastecimento", "event": [{ "listen": "test", "script": { "exec": ["pm.test('OK', function () { pm.expect(pm.response.code).to.be.oneOf([200, 204]); });"] } }], "request": { "method": "DELETE", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/abastecimentos/{{abastecimento_id}}", "host": ["{{central_api}}"], "path": ["abastecimentos", "{{abastecimento_id}}"] } } },
