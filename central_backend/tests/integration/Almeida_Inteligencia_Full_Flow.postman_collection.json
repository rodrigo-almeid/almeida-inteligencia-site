				] } }], "request": { "method": "PUT", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"descricao\": \"Conta EDITADA\",\n  \"vencimento\": \"2026-07-20\",\n  \"competencia\": \"2026-07\",\n  \"valor\": 200.00,\n  \"natureza\": \"débito\",\n  \"status\": \"Pago\",\n  \"categoria_id\": {{categoria_id}}\n}" }, "url": { "raw": "{{central_api}}/contas/{{conta_id}}", "host": ["{{central_api}}"], "path": ["contas", "{{conta_id}}"] } } },
