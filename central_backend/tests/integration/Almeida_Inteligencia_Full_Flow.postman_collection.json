				] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }], "body": { "mode": "urlencoded", "urlencoded": [{ "key": "username", "value": "{{test_email}}" }, { "key": "password", "value": "{{test_password}}" }] }, "url": { "raw": "{{central_api}}/auth/login", "host": ["{{central_api}}"], "path": ["auth", "login"] } } },
				{ "name": "04.3 Criar Categoria", "event": [{ "listen": "test", "script": { "exec": [
