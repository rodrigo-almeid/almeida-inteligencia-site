	"event": [{ "listen": "prerequest", "script": { "exec": [
		"if (!pm.collectionVariables.get('test_email') || pm.collectionVariables.get('test_email') === '') {",
		"    pm.collectionVariables.set('test_email', 'postman_rbac_' + Date.now() + '@teste.com');",
		"}"
	] } }],
	"item": [
		{
			"name": "01 — Auth + Setup",
			"item": [
				{ "name": "01.1 Login Admin", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
					"pm.test('Token salvo', function () { pm.collectionVariables.set('admin_token', pm.response.json().access_token); });"
				] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }], "body": { "mode": "urlencoded", "urlencoded": [{ "key": "username", "value": "{{admin_email}}" }, { "key": "password", "value": "{{admin_password}}" }] }, "url": { "raw": "{{central_api}}/auth/login", "host": ["{{central_api}}"], "path": ["auth", "login"] } } },
				{ "name": "01.2 Registrar Usuário", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('Status 201', function () { pm.expect(pm.response.code).to.equal(201); });",
					"pm.test('Sucesso', function () { pm.expect(pm.response.json().message).to.include('sucesso'); });"
				] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\"email\": \"{{test_email}}\", \"password\": \"{{test_password}}\"}" }, "url": { "raw": "{{central_api}}/auth/register", "host": ["{{central_api}}"], "path": ["auth", "register"] } } },
				{ "name": "01.3 Login Usuário", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
					"pm.test('JWT válido', function () { var j = pm.response.json(); pm.expect(j.access_token.split('.').length).to.equal(3); pm.collectionVariables.set('token', j.access_token); });",
					"pm.test('Bearer', function () { pm.expect(pm.response.json().token_type.toLowerCase()).to.equal('bearer'); });"
				] } }], "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }], "body": { "mode": "urlencoded", "urlencoded": [{ "key": "username", "value": "{{test_email}}" }, { "key": "password", "value": "{{test_password}}" }] }, "url": { "raw": "{{central_api}}/auth/login", "host": ["{{central_api}}"], "path": ["auth", "login"] } } },
				{ "name": "01.4 Perfis = vazio", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
					"pm.test('Sem perfis', function () { pm.expect(pm.response.json()).to.be.an('array').with.length(0); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/me/perfis", "host": ["{{central_api}}"], "path": ["me", "perfis"] } } }
			]
		},
		{
