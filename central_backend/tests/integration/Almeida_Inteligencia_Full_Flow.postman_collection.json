					"pm.test('Indica perfil automacao_financeira', function () { pm.expect(pm.response.json().detail).to.include('automacao_financeira'); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/categorias/", "host": ["{{central_api}}"], "path": ["categorias", ""] } } },
				{ "name": "02.2 /contas/ → 403", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('403', function () { pm.expect(pm.response.code).to.equal(403); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/contas/", "host": ["{{central_api}}"], "path": ["contas", ""] } } },
				{ "name": "02.3 /dividas/ → 403", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('403', function () { pm.expect(pm.response.code).to.equal(403); });"
