{
	"info": {
		"_postman_id": "almeida-inteligencia-full-flow",
		"name": "Almeida Inteligência — Fluxo Completo (RBAC + CRUD + Cleanup)",
		"description": "Fluxo E2E: registra usuário, valida RBAC (403 sem perfil), atribui perfis, faz CRUD completo e limpa tudo.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "https://almeidainteligencia.com.br" },
		{ "key": "central_api", "value": "{{base_url}}/central" },
		{ "key": "token", "value": "" },
		{ "key": "admin_token", "value": "" },
		{ "key": "test_email", "value": "" },
		{ "key": "test_password", "value": "Test@12345" },
		{ "key": "admin_email", "value": "almeidainteligencia@gmail.com" },
		{ "key": "admin_password", "value": "REDACTED" },
		{ "key": "categoria_id", "value": "" },
		{ "key": "conta_id", "value": "" },
		{ "key": "divida_id", "value": "" },
		{ "key": "pessoa_id", "value": "" },
		{ "key": "senha_id", "value": "" },
		{ "key": "dado_pessoal_id", "value": "" },
		{ "key": "abastecimento_id", "value": "" }
