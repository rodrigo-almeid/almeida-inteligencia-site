		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "base_url", "value": "http://147.15.47.151:8080" },
		{ "key": "central_api", "value": "{{base_url}}/central" },
		{ "key": "token", "value": "" },
		{ "key": "test_email", "value": "" },
		{ "key": "test_password", "value": "Test@12345" },
		{ "key": "categoria_id", "value": "" },
		{ "key": "conta_id", "value": "" },
		{ "key": "divida_id", "value": "" },
		{ "key": "pessoa_id", "value": "" },
		{ "key": "senha_id", "value": "" },
		{ "key": "dado_pessoal_id", "value": "" },
		{ "key": "abastecimento_id", "value": "" }
