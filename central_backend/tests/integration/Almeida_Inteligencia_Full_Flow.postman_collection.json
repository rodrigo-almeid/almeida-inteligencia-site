	"event": [
		{
			"listen": "prerequest",
			"script": {
				"exec": [
					"if (!pm.collectionVariables.get('test_email') || pm.collectionVariables.get('test_email') === '') {",
					"    pm.collectionVariables.set('test_email', 'postman_test_' + Date.now() + '@teste.com');",
					"}"
				]
			}
		}
	],
	"item": [
		{
			"name": "01 — Autenticação",
			"item": [
				{
					"name": "01.1 Registrar Usuário",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status 201 Created', function () { pm.expect(pm.response.code).to.equal(201); });",
						"pm.test('Response time < 5s', function () { pm.expect(pm.response.responseTime).to.be.below(5000); });",
						"pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
						"pm.test('Mensagem de sucesso', function () { var j = pm.response.json(); pm.expect(j).to.have.property('message'); pm.expect(j.message).to.include('sucesso'); });",
						"pm.test('Sem erro', function () { pm.expect(pm.response.json()).to.not.have.property('detail'); });"
					] } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{test_email}}\",\n  \"password\": \"{{test_password}}\"\n}" }, "url": { "raw": "{{central_api}}/auth/register", "host": ["{{central_api}}"], "path": ["auth", "register"] } }
				},
				{
					"name": "01.2 Login",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
						"pm.test('Response time < 3s', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
						"pm.test('Content-Type JSON', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
						"pm.test('access_token é string não vazia', function () { var j = pm.response.json(); pm.expect(j.access_token).to.be.a('string').and.not.empty; pm.collectionVariables.set('token', j.access_token); });",
						"pm.test('Token formato JWT (3 partes)', function () { pm.expect(pm.response.json().access_token.split('.').length).to.equal(3); });",
						"pm.test('token_type bearer', function () { pm.expect(pm.response.json().token_type.toLowerCase()).to.equal('bearer'); });"
					] } }],
					"request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }], "body": { "mode": "urlencoded", "urlencoded": [{ "key": "username", "value": "{{test_email}}" }, { "key": "password", "value": "{{test_password}}" }] }, "url": { "raw": "{{central_api}}/auth/login", "host": ["{{central_api}}"], "path": ["auth", "login"] } }
				},
				{
					"name": "01.3 Listar Perfis",
					"event": [{ "listen": "test", "script": { "exec": [
						"pm.test('Status 200', function () { pm.expect(pm.response.code).to.equal(200); });",
						"pm.test('Response time < 3s', function () { pm.expect(pm.response.responseTime).to.be.below(3000); });",
						"pm.test('Resposta é array', function () { pm.expect(pm.response.json()).to.be.an('array'); });",
						"pm.test('Não 401 (token válido)', function () { pm.expect(pm.response.code).to.not.equal(401); });"
					] } }],
					"request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/me/perfis", "host": ["{{central_api}}"], "path": ["me", "perfis"] } }
				}
			]
		},
