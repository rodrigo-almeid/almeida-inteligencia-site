				{ "name": "03.4 /contas/ → 200", "event": [{ "listen": "test", "script": { "exec": [
					"pm.test('200 — acesso permitido', function () { pm.expect(pm.response.code).to.equal(200); });"
				] } }], "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }], "url": { "raw": "{{central_api}}/contas/", "host": ["{{central_api}}"], "path": ["contas", ""] } } },
				{ "name": "03.5 /pessoas/ → 403", "event": [{ "listen": "test", "script": { "exec": [
